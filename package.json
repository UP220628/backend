{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "body-app-backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "type-check": "tsc --noEmit",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/app.js",
